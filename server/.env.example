PORT=5000
CLIENT_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=replace-with-your-16-character-google-app-password
SMTP_FROM=WebMatrix <yourgmail@gmail.com>

# Recommended for Render Free, which blocks outbound SMTP ports.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=WebMatrix <onboarding@resend.dev>

# Begin with Razorpay Test Mode keys. Replace them with Live Mode keys only after testing.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
